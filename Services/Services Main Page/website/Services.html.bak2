    <script src="../../Universal/webflow_assets/js/jquery-3.5.1.min.dc5e7f18c8.js" type="text/javascript"></script>
    <script src="../../Universal/webflow_assets/js/webflow.schunk.36b8fb49256177c8.js" type="text/javascript"></script>
    <script src="../../Universal/webflow_assets/js/webflow.schunk.6c5f0e73e7c4c200.js" type="text/javascript"></script>
    <script src="../../Universal/webflow_assets/js/webflow.schunk.61b534daaaeddbc7.js" type="text/javascript"></script>
    <script src="../../Universal/webflow_assets/js/webflow.schunk.121b0d7ff03e0f4a.js" type="text/javascript"></script>
    <script src="../../Universal/webflow_assets/js/webflow.d0509937.b285daf4e1885937.js" type="text/javascript"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const apiKey = '012fdea1778b4bcbb98a701bae959a5f';
    const apiUrl = 'https://api.fuelsa.co.za/exapi/fuel/current';

    fetch(apiUrl, {
        method: 'GET',
        headers: {
            'key': apiKey
        }
    })
    .then(response => response.json())
    .then(data => {
        // Format price function (cents to R)
        const formatPrice = (cents) => 'R' + (cents / 100).toFixed(2);
        
        // Format date function
        const formatDate = (isoString) => {
            const date = new Date(isoString);
            return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        };

        if(data.petrol && data.petrol.length > 0) {
            document.getElementById('petrol-date').textContent = 'Last price change: ' + formatDate(data.petrol[0].date);
            data.petrol.forEach(item => {
                if(item.location === 'Reef') {
                    if(item.octane === '93' && item.type === 'Unleaded') document.getElementById('petrol-reef-93').textContent = formatPrice(item.value);
                    if(item.octane === '95' && item.type === 'Unleaded') document.getElementById('petrol-reef-95').textContent = formatPrice(item.value);
                    if(item.octane === '95' && item.type === 'LRP') document.getElementById('petrol-reef-lrp').textContent = formatPrice(item.value);
                }
                if(item.location === 'Coast') {
                    if(item.octane === '93' && item.type === 'Unleaded') document.getElementById('petrol-coast-93').textContent = formatPrice(item.value);
                    if(item.octane === '95' && item.type === 'Unleaded') document.getElementById('petrol-coast-95').textContent = formatPrice(item.value);
                    if(item.octane === '95' && item.type === 'LRP') document.getElementById('petrol-coast-lrp').textContent = formatPrice(item.value);
                }
            });
        }

        if(data.diesel && data.diesel.length > 0) {
            document.getElementById('diesel-date').textContent = 'Last price change: ' + formatDate(data.diesel[0].date);
            data.diesel.forEach(item => {
                if(item.location === 'Reef') {
                    if(item.ppm === '50') document.getElementById('diesel-reef-50').textContent = formatPrice(item.value);
                    if(item.ppm === '500') document.getElementById('diesel-reef-500').textContent = formatPrice(item.value);
                }
                if(item.location === 'Coast') {
                    if(item.ppm === '50') document.getElementById('diesel-coast-50').textContent = formatPrice(item.value);
                    if(item.ppm === '500') document.getElementById('diesel-coast-500').textContent = formatPrice(item.value);
                }
            });
        }
    })
    .catch(error => {
        console.error('Error fetching fuel prices:', error);
    });
});
</script>
